{
  "name": "blipmade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/site/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173",
    "start": "node server.mjs",
    "sync": "node scripts/sync-catalog.mjs && node scripts/sync-docs-meta.mjs",
    "sync:docs": "node scripts/sync-docs-meta.mjs",
    "og": "node scripts/make-og.mjs",
    "test": "node --test --experimental-strip-types tests/*.test.ts tests/*.test.mjs",
    "start:pterodactyl": "npm ci --include=dev && npm run build && node server.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/funnel-display": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@sentry/browser": "^11.10.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@types/node": "^22.20.5",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
