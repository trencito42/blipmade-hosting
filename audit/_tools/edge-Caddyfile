# The edge of Blipmade — reference configuration
#
# This file is the reference for the reverse proxy that stands in front of the
# platform. The edge itself runs on another host (10.77.0.12) and its real
# configuration is not in this repository; this file states the convention the
# platform depends on, so that the convention is a fact that can be checked
# and not only a belief.
#
# WHY THIS FILE EXISTS
#
# The web server resolves the address of the client from the chain of the
# `X-Forwarded-For` header, reading the chain from the right: the last
# address of the chain that is not a known proxy is the address of the client.
#
# That only works if the edge REPLACES the header. The default behaviour of a
# reverse proxy is to APPEND the address of the client to whatever the client
# sent, so a visitor that sends its own `X-Forwarded-For` keeps its forged
# values at the head of the chain. A chain with a single element — the one
# the client forged itself — is then indistinguishable from the chain the
# edge wrote, and the platform believes the forged address.
#
# With `trusted_proxies` set, Caddy ignores the header of the visitor and
# writes the address it resolved from the trusted chain. The forged values
# are dropped at the edge, so the chain the platform reads is the chain the
# edge wrote.
#
# The verification is in the audit log: the address of the visitor is the one
# that is written down, and it is never a range of the proxy.
#
#     docker exec blipmade-postgres-1 psql -U blipmade -d blipmade \
#       -c "SELECT ip, count(*) FROM \"AuditLog\" GROUP BY ip ORDER BY count(*) DESC LIMIT 10;"
#
# CHECKLIST FOR THE OPERATOR
#
#  1. The list of the trusted proxies is the list of the network of the
#     visitor (below: the ranges of the CDN). It must be as narrow as
#     possible: a wide list means the addresses of other networks are
#     believed too.
#  2. `header_up X-Forwarded-For {client_ip}` writes the resolved address and
#     nothing else, so the chain that reaches the platform has one element
#     that the platform can trust.
#  3. `header_up X-Forwarded-Proto {scheme}` is what makes the cookie of the
#     session `Secure` behind a TLS edge.
#  4. After the change, restart the web container and send one request with a
#     forged header:
#
#         curl -s -H 'X-Forwarded-For: 9.9.9.9' https://blipmade.com/api/health
#
#     and check that the address written in the audit log is the address of
#     the caller and not `9.9.9.9`.
#
# The ranges below are the published ranges of the CDN. Check them against the
# current list of the operator before applying them.
#
# ---------------------------------------------------------------------------
# THE ROUTES OF THE CUSTOMER DOMAINS
# ---------------------------------------------------------------------------
#
# The platform creates a route for every customer hostname that proved its
# ownership. The route is written through the administrative API of Caddy,
# into the namespace of the server named in `CADDY_APP_SERVER` (the default is
# `blipmade`):
#
#     POST {CADDY_ADMIN_URL}/config/apps/http/servers/blipmade/routes
#     { "match": [ { "host": [ "witch.pw" ] } ],
#       "handle": [ { "handler": "reverse_proxy",
#                     "upstreams": [ { "dial": "10.77.0.11:30001" } ] } ],
#       "terminal": true }
#
# Three things have to be true on the edge, and none of them can be checked
# from the server of the platform:
#
#  1. The administrative API has to listen on an address the platform can
#     reach. By default Caddy listens on `localhost:2019` only, and the
#     platform on 10.77.0.13 cannot reach that. The address has to be given
#     in the global options (`admin 10.77.0.12:2019`), and the firewall has to
#     let 10.77.0.13 reach it and nothing else. The token of the
#     administrative API is `CADDY_ADMIN_TOKEN` on the platform.
#
#  2. The namespace has to exist. Without a server named `blipmade` inside
#     the `apps` block, the answer of the administrative API is 404 and the
#     platform refuses to route anything. The block below creates it.
#
#  3. The server has to reach the container of the customer. The route dials
#     the address and the port of the allocation on the node (for example
#     `10.77.0.11:30001`), so the edge has to be able to open a connection to
#     the node on the ports of the allocations.
#
# The certificate of a customer hostname is a decision of the operator: the
# hostnames are not known in advance, so Caddy cannot ask for a certificate
# for them on its own. The usual answer is to serve them through a CDN that
# terminates TLS, and to let the edge answer that CDN over HTTP, or to give
# the edge a certificate that covers the hostnames.
#
# If the Caddy of the operator cannot carry a second server on the same
# addresses, the platform can be pointed at the server that already exists:
# set `CADDY_APP_SERVER` to its name, and the platform writes the routes
# there. The isolation of the routes is then the isolation by the prefix of
# the route id (`blipmade-route-`), not a server of its own.

{
	# The administrative API of Caddy. It is not exposed publicly: only the
	# server of the platform (10.77.0.13) has to reach it.
	admin 10.77.0.12:2019

	# The routes of the customer domains live in a server of their own, so
	# the routes of the operator are never read, replaced or removed by the
	# platform. The routes themselves are added by the platform; the server
	# only has to exist and to listen.
	apps {
		http {
			servers {
				blipmade {
					# The hostnames of the customers arrive here. The address
					# has to be the one the public DNS of the platform points
					# at (the A record of the customer domain points at the
					# same address as the site of the platform).
				}
			}
		}
	}
}

blipmade.com {
	encode zstd gzip

	reverse_proxy 10.77.0.13:3000 {
		# The visitors arrive through the CDN, so the CDN is the proxy that is
		# believed. Everything else is a client that writes its own header.
		trusted_proxies static \
			173.245.48.0/20 \
			103.21.244.0/22 \
			103.22.200.0/22 \
			103.31.4.0/22 \
			141.101.64.0/18 \
			108.162.192.0/18 \
			190.93.240.0/20 \
			188.114.96.0/20 \
			197.234.240.0/22 \
			198.41.128.0/17 \
			162.158.0.0/16 \
			104.16.0.0/13 \
			104.24.0.0/14 \
			172.64.0.0/13 \
			131.0.72.0/22 \
			2400:cb00::/32 \
			2606:4700::/32 \
			2803:f800::/32 \
			2405:b500::/32 \
			2405:8100::/32 \
			2a06:98c0::/29 \
			2c0f:f248::/32

		# The header is written, not appended: the address the edge resolved
		# is the only address the platform sees.
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-Proto {scheme}
	}
}
