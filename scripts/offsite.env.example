# /etc/blipmade/offsite.env  (root:root, mode 600). Copy this file, fill it in on the machine, never commit the copy.
# The age IDENTITY (private key) does NOT go on this machine. Only the public recipient does.
OFFSITE_TRANSPORT=ssh
OFFSITE_HOST=u706911@u706911.your-storagebox.de
OFFSITE_PORT=23
OFFSITE_KEY=/etc/blipmade/storagebox_key
OFFSITE_KNOWN_HOSTS=/etc/blipmade/storagebox_known_hosts
OFFSITE_BASE=blipmade
OFFSITE_AGE_RECIPIENT=age1...
# Optional. Only on a drill host that should decrypt. Leave unset on the
# hypervisor. When set, destination probes compare `age-keygen -y` to the
# recipient above and report a mismatch without printing keys.
# OFFSITE_AGE_IDENTITY=/home/debian/.blipmade-backup-bitwarden.age
REPORT_URL=https://blipmade.com/api/internal/backups
REPORT_TOKEN=...
NODE_NAME=games-node-01
CAPACITY_MAX_PERCENT=85
BWLIMIT_KBPS=40000
RETENTION_CUSTOMER_DAYS=30
RETENTION_DB_DAILY=7
RETENTION_DB_WEEKLY=4
RETENTION_VPS_KEEP=3
