# The read-only token of Proxmox for the exporter: user@realm!tokenid and its secret.
PVE_USER=monitor@pve
PVE_TOKEN_NAME=exporter
PVE_TOKEN_VALUE=change-me
PVE_URL=https://10.77.0.1:8006
# The token the platform wants for its measures (METRICS_TOKEN of the API).
PLATFORM_METRICS_TOKEN=change-me
# The password of the admin of Grafana.
GRAFANA_ADMIN_PASSWORD=change-me
# The webhook of Discord that receives the alerts (Alertmanager speaks to it through /slack-compatible URL).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN/slack
