// Blipmade platform schema.
// Money is always stored as integer minor units (EUR cents). Never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  /// Provider-aware canonical address used to stop trivial alias accounts.
  emailIdentity  String?   @unique
  passwordHash   String
  // The name of the customer in two parts. The panel account of this customer
  // carries the same two parts, so no name is ever invented.
  firstName      String
  lastName       String
  role           Role      @default(CUSTOMER)
  emailVerifiedAt DateTime?
  billingAddress Json?
  // The panel account that belongs to this customer. The mapping is
  // permanent and is never derived from an address.
  pterodactylUserId String?
  // The external id that the panel account carries. It is the only link
  // between the two identities, and it is what a reconciliation looks up.
  pterodactylExternalId String? @unique
  suspendedAt    DateTime?
  // The moment the customer asked for the account to be closed. The account is
  // not deleted by the request: a person looks at it first.
  deletionRequestedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions       Session[]
  tokens         VerificationToken[]
  staff          StaffMember?
  mailDomains    MailDomain[]
  mailServices   MailService[]
  notifications        Notification[]
  notificationEvents   NotificationEvent[]
  orders         Order[]
  instances      Instance[]
  tickets        Ticket[]
  ticketMessages TicketMessage[]
  auditLogs      AuditLog[]
  invoices       Invoice[]
  payments       Payment[]
  subscriptions  Subscription[]
  promotions     Promotion[] @relation("PromotionCreator")
  promotionRedemptions PromotionRedemption[]
  panelCredential PanelCredential?
  emailChangeRequests EmailChangeRequest[]
  notificationPreference NotificationPreference?

  @@index([role])
  @@index([pterodactylUserId])
  // The list of the customers is ordered by the moment of the account and by
  // the id, so the page after the first one is read without sorting the whole
  // table.
  @@index([createdAt, id])
}

/// What is known about one message of the platform.
///
/// The row holds the state of the delivery, never the body of the message and
/// never a token: it says that a message was queued, delivered or written to
/// disk, and how many attempts it took.
model MailDelivery {
  /// The key of the message. It is a hash of the token, so it cannot be used
  /// to sign in and it is the same in every process.
  key             String   @id
  kind            String
  /// The event that caused the message, when the message came from the
  /// notification engine. It is empty for the messages that the platform
  /// sends on its own, e.g. the verification of the address.
  eventId         String?
  to              String
  /// queued, delivered, written-to-file or failed.
  state           String
  transport       String   @default("file")
  attempts        Int      @default(0)
  lastErrorClass  String?
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  deliveredAt     DateTime?

  @@index([state])
  @@index([createdAt])
  @@index([eventId])
}

/// A domain event of the platform, written in the same transaction as the
/// business change that caused it.
///
/// The row is the outbox: the work of turning the event into a message is
/// done later, by the dispatcher, so a failure of the mail server never
/// rolls back a payment or a provisioning. The row also keeps the story of
/// what was done with the event, so the back office can answer "was this
/// event ever sent?" without guessing.
model NotificationEvent {
  id        String @id @default(cuid())
  /// The kind of the event, e.g. "payment.succeeded".
  type      String
  /// The identity of the occurrence.
  ///
  /// It is built from the business identity of the thing that happened AND
  /// from the occurrence itself, so the same service can be suspended and
  /// reactivated as many times as it happens and every occurrence has its
  /// own message. A key built only from the name and the state would keep
  /// every future occurrence of the same state silent.
  businessKey String @unique
  /// The customer the event belongs to. It is empty for the events that are
  /// about the operator, e.g. a backup that failed.
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The facts of the event. They are validated when the event is written.
  payload   Json
  /// The state of the event: pending, processed or failed.
  state     String  @default("pending")
  /// What was done with the event, per channel: "sent", "skipped", "failed".
  channels  Json    @default("{}")
  attempts  Int     @default(0)
  lastError String?
  /// When the thing happened, as the business says it.
  occurredAt DateTime @default(now())
  processedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([state, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

/// One message of the notification centre of a customer.
///
/// The row belongs to one customer and to one occurrence of an event, so a
/// customer can never read the message of another customer, even when the
/// two are in the same company.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The category of the message: the same categories as the preferences.
  category  String
  title     String
  body      String
  /// Where the message leads: the service, the invoice, the ticket.
  actionUrl   String?
  actionLabel String?
  /// The occurrence of the event that produced the message. One message per
  /// occurrence, so the same message is never written twice.
  eventKey  String   @unique
  /// When the customer read the message. It is empty while it is unread.
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// A change of the address of a customer.
///
/// The new address is only used when it has answered. Until then the address
/// of the account stays the old one, so a mistyped address cannot lock a
/// customer out of the account.
model EmailChangeRequest {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  // The hash of the token that was sent to the new address. The token itself
  // is never stored and never written in a log.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// What a customer wants to hear about.
///
/// The preferences are kept with the account. They say what the customer
/// wants, not what has been sent: the delivery itself depends on the mail
/// relay of the deployment.
model NotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productUpdates Boolean  @default(true)
  billing        Boolean  @default(true)
  support        Boolean  @default(true)
  incidents      Boolean  @default(true)
  marketing      Boolean  @default(false)
  /// The group of the messages about the account and its security. It is an
  /// essential group: the customer cannot switch it off, because these
  /// messages protect the account itself.
  accountSecurity Boolean @default(true)
  /// The group of the messages about the orders and the invoices.
  ordersBilling Boolean @default(true)
  /// The group of the messages about the hosting services.
  hostingServices Boolean @default(true)
  /// The group of the messages about the domains and the hosted mail.
  domainsEmail Boolean @default(true)
  /// The channel of the e-mail as a whole. It never switches off the
  /// essential messages, whatever it says.
  emailChannel Boolean @default(true)
  /// The channel of the notification centre as a whole.
  inAppChannel Boolean @default(true)
  /// When the customer agreed to receive the messages of the marketing. The
  /// agreement is kept with a date, so the back office can answer "did they
  /// agree?" without guessing.
  marketingOptInAt DateTime?
  updatedAt      DateTime @updatedAt
}

/// The client credential of one customer on the panel.
///
/// The panel issues one client API key per customer. The key is scoped to the
/// panel account of that customer, so it can only reach the servers of that
/// customer, and it is stored encrypted on this server. It never reaches the
/// browser.
model PanelCredential {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The panel account the key belongs to.
  panelUserId Int
  // The external id of that account on the panel.
  externalId  String
  // The client key, encrypted with the session secret of this deployment.
  tokenEnc    String
  // Where the key came from: "bridge" when the panel issued it on request,
  // "bootstrap" when an operator handed it over.
  source      String   @default("bridge")
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip        String?
  userAgent String?
  // The moment the session was last used. It is written at most once every
  // five minutes, so the list of the sessions can tell two sessions of the
  // same device apart without a write on every request.
  lastSeenAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, createdAt])
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model VerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  type      TokenType
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

model StaffMember {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String[] @default([])
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignedTickets Ticket[] @relation("TicketAssignee")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

enum Category {
  WEB_CMS
  DEVELOPER_TOOLS
  MONITORING
  AUTOMATION
  BOTS
  DATABASES
  EMAIL_HOSTING
  GAMES
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

/// What the platform delivers when a product is bought.
enum ProductFulfilment {
  /// A server on a node of the panel. The product needs an egg.
  SERVER
  /// A hosted mail service. The product needs no server and no panel.
  EMAIL
}

/// The window in which the limit of sending of a domain is counted.
enum MailSendingInterval {
  MINUTELY
  HOURLY
  DAILY
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    Category
  description String
  icon        String
  // Pterodactyl egg mapping.
  eggId       Int?
  eggUuid     String?
  // The name of the egg the product runs on. The number of an egg belongs to
  // the panel and is given when the egg is imported, so a product that names
  // its egg keeps working when the panel is moved or when the egg is
  // imported again. The number is used when it is set.
  eggName     String?
  dockerImage String?
  startup     Json?
  // The variables the platform makes for every instance of this product, such
  // as the password of a database. They are written in the environment of the
  // container and shown to the owner of the instance:
  // { "PGPASSWORD": { "length": 20 } }
  generatedVariables Json?
  // The variables of the egg that the customer has to fill at the order: the
  // licence of a game, the key of an API, the name of the administrator.
  // The platform asks for them, keeps them sealed and puts them in the
  // environment of the container:
  // { "STEAM_USER": { "label": "Steam account", "required": true } }
  customerVariables Json?
  // The command the container runs. Overrides the egg default when set.
  startupCommand String?
  // Minimum resources required to run.
  //
  // The processor is counted in vCPU and it may be a half: a small bot of half
  // a processor is a thing the panel can build, and the price of the
  // resources is the same for every product.
  minRam      Int      @default(512)
  minCpu      Float    @default(1)
  minDisk     Int      @default(5)
  // Default resources used when deploying.
  defaultRam  Int      @default(512)
  defaultCpu  Float    @default(1)
  defaultDisk Int      @default(5)
  maxRam      Int      @default(16384)
  maxCpu      Float    @default(4)
  maxDisk     Int      @default(100)
  visible     Boolean  @default(true)
  // Only genuinely validated products may be ordered.
  deployable  Boolean  @default(false)
  // What the platform delivers when this product is bought. A product of
  // category EMAIL_HOSTING is delivered as a mail service, without a server.
  fulfilment ProductFulfilment @default(SERVER)
  // The limits of a mail plan. They are empty for a product of servers: the
  // limits of a server are the ones of the resources it uses.
  /// How many domains the plan includes.
  mailMaxDomains Int?
  /// How many mailboxes a domain of the plan may hold.
  mailMaxMailboxes Int?
  /// How many aliases a domain of the plan may hold.
  mailMaxAliases Int?
  /// How many forwarding rules a domain of the plan may hold.
  mailMaxForwarding Int?
  /// How much space the plan includes, in megabytes.
  mailTotalStorageMb Int?
  /// How much space one mailbox of the plan may hold, in megabytes.
  mailMailboxQuotaMb Int?
  /// How many messages may be sent in the window of the interval.
  mailSendLimit Int?
  /// The window in which the limit of sending is counted.
  mailSendInterval MailSendingInterval?
  // How the deployment of this product is verified: { kind: 'http' | 'tcp',
  // path, expectStatus, expectBody }.
  healthProbe Json?
  docsUrl     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prices      ProductPrice[]
  options     ProductOption[]
  items       OrderItem[]
  instances   Instance[]
  mailServices MailService[]

  @@index([visible, deployable])
  @@index([category])
}

model ProductPrice {
  id           String        @id @default(cuid())
  productId    String
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  period       BillingPeriod @default(MONTHLY)
  // Amount for the minimum configuration, in minor units.
  baseAmount   Int
  // Price per additional GB of RAM, in minor units.
  ramPerGb     Int           @default(60)
  cpuPerUnit   Int           @default(40)
  diskPerGb    Int           @default(2)
  currency     String        @default("EUR")
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([productId, period, active])
}

/// Paid add-on features that can be attached to an order.
model ProductOption {
  id        String   @id @default(cuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  code      String   @unique
  name      String
  description String?
  amount    Int
  currency  String   @default("EUR")
  recurring Boolean  @default(true)
  active    Boolean  @default(true)

  @@index([productId])
}

/// Cached copy of a Pterodactyl node.
model Node {
  id              String   @id @default(cuid())
  pterodactylId   Int      @unique
  name            String
  fqdn            String
  memory          Int
  disk            Int
  memoryAllocated Int      @default(0)
  diskAllocated   Int      @default(0)
  maintenance     Boolean  @default(false)
  syncedAt        DateTime @default(now())
}

/// Cached copy of a Pterodactyl egg.
model Egg {
  id            String   @id @default(cuid())
  pterodactylId Int      @unique
  uuid          String
  name          String
  dockerImage   String
  startup       String
  syncedAt      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Customers, orders and billing
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  FULFILLED
  FAILED
  CANCELLED
  REFUNDED
}

/// A new purchase, or a paid change applied to an existing instance.
enum OrderKind {
  NEW
  UPGRADE
}

/// Tracks whether the paid order actually produced running services.
/// It is deliberately separate from Order.status, which only describes money.
enum FulfillmentStatus {
  NOT_STARTED
  PROVISIONING
  FULFILLED
  FAILED
}

model Order {
  id         String      @id @default(cuid())
  number     String      @unique
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     OrderStatus @default(PENDING)
  /// NEW orders create instances, UPGRADE orders change the resources of one.
  kind       OrderKind   @default(NEW)
  /// Set on UPGRADE orders: the instance whose resources are being changed.
  instanceId String?
  instance   Instance?   @relation("UpgradeOrders", fields: [instanceId], references: [id], onDelete: SetNull)
  /// The requested resources of an UPGRADE order, frozen like an order item.
  requestedConfig Json?
  /// Money state and fulfilment state are tracked separately.
  fulfillmentStatus FulfillmentStatus @default(NOT_STARTED)
  total      Int
  currency   String      @default("EUR")
  billingAddress Json?
  promotionId String?
  promotion  Promotion?  @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  discount   Int         @default(0)
  /// Set when the promotion was actually consumed by a paid order.
  promotionRedeemedAt DateTime?
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String?
  paidAt     DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  items    OrderItem[]
  payments Payment[]
  invoices Invoice[]
  instances Instance[]
  promotionRedemption PromotionRedemption?

  @@index([userId, status])
  @@index([status])
  @@index([kind])
  @@index([instanceId])
  // The list of the orders is ordered by the moment of the order and by the
  // id.
  @@index([createdAt, id])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  name       String
  quantity   Int      @default(1)
  unitAmount Int
  total      Int
  currency   String   @default("EUR")
  // Frozen resource configuration, so prices never change retroactively.
  config     Json?
  // The state of the delivery of this line, on its own. A line of mail is
  // delivered by the mail system and a line of servers by the panel, so the
  // two progress separately: one of them can fail while the other works.
  fulfillmentStatus FulfillmentStatus @default(NOT_STARTED)
  // Why the delivery of this line failed, in words.
  fulfillmentError String?

  // Every order line owns at most one subscription, so a multi-item checkout
  // produces one subscription per item instead of one for the whole order.
  subscription Subscription?
  instances    Instance[]
  mailService  MailService?

  @@index([orderId])
  @@index([fulfillmentStatus])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  instanceId           String?            @unique
  instance             Instance?          @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  // The order line this subscription pays for.
  orderItemId          String?            @unique
  orderItem            OrderItem?         @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  // The Stripe subscription can cover several order lines, so the id is not
  // unique here. The Stripe subscription *item* is what identifies one line.
  stripeSubscriptionId String?
  stripeSubscriptionItemId String? @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(INCOMPLETE)
  quantity             Int                @default(1)
  amount               Int
  currency             String             @default("EUR")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  cancelledAt          DateTime?
  /// Last time the renewal sweep looked at this subscription.
  lastRenewalCheckAt   DateTime?
  // A subscription of a mail service. A mail service has no instance, so the
  // link is here: the subscription of the mail is the one that is renewed,
  // suspended and cancelled with the mail and not with a server.
  mailService          MailService?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId])
  @@index([status])
  @@index([cancelAtPeriodEnd])
  @@index([stripeSubscriptionId])
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId        String?
  order          Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  stripeInvoiceId String?      @unique
  stripeSubscriptionId String?
  stripeCustomerId String?
  status         InvoiceStatus @default(DRAFT)
  amount         Int
  tax            Int           @default(0)
  total          Int
  currency       String        @default("EUR")
  billingAddress Json?
  hostedUrl      String?
  pdfUrl         String?
  paidAt         DateTime?
  periodStart    DateTime?
  periodEnd      DateTime?
  dueDate        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  // The list of the invoices is ordered by the moment of the invoice and by
  // the id.
  @@index([createdAt, id])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                     String        @id @default(cuid())
  userId                 String
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId                String?
  order                  Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  stripePaymentIntentId  String?       @unique
  stripeChargeId         String?
  // The Stripe customer is what the billing portal needs, so it is stored as
  // soon as a checkout session exposes it.
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  stripeInvoiceId        String?       @unique
  amount                 Int
  currency               String        @default("EUR")
  status                 PaymentStatus @default(PENDING)
  failureMessage         String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([stripeCustomerId])
}

enum PromotionType {
  PERCENT
  FIXED
}

model Promotion {
  id             String        @id @default(cuid())
  code           String        @unique
  type           PromotionType
  value          Int
  maxRedemptions Int?
  /// How many times a single account may use the code.
  maxPerUser     Int?
  usedCount      Int           @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean       @default(true)
  createdById    String?
  createdBy      User?         @relation("PromotionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  orders Order[]
  /// One row per paid order that used the promotion. Redemptions are counted
  /// from this table, never from an unpaid order.
  redemptions PromotionRedemption[]

  @@index([active])
}

/// A promotion that was actually used by a paid order.
/// The unique constraint makes the redemption idempotent: a redelivered
/// webhook cannot consume the promotion twice.
model PromotionRedemption {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// The discounted amount, in minor units.
  amount      Int
  /// HMAC-SHA256 of Stripe's card fingerprint. The raw card fingerprint is
  /// never stored, while the unique pair still enforces one card per campaign.
  cardFingerprintHash String?
  createdAt   DateTime  @default(now())

  @@unique([promotionId, cardFingerprintHash])
  @@index([promotionId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Instances
// ---------------------------------------------------------------------------

enum InstanceStatus {
  PENDING
  PROVISIONING
  ONLINE
  RESTARTING
  STOPPED
  DEGRADED
  FAILED
  SUSPENDED
  CANCELLED
}

model Instance {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId         String
  product           Product        @relation(fields: [productId], references: [id])
  orderId           String?
  order             Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // The order line this instance was provisioned from. A line with a quantity
  // above one produces several instances that all point at the same line.
  orderItemId       String?
  orderItem         OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  name              String
  status            InstanceStatus @default(PENDING)
  pterodactylServerId Int?          @unique
  pterodactylUuid   String?        @unique
  // The allocation that the panel really assigned. The port of the service
  // is read from it and is never assumed.
  pterodactylAllocation Int?
  pterodactylNodeId     Int?
  ram               Int
  cpu               Float
  disk              Int
  price             Int
  currency          String         @default("EUR")
  // Idempotency key used by the provisioning worker.
  provisioningKey   String?        @unique
  provisionError    String?
  // The last provisioning step that completed successfully. A retry resumes
  // after this step instead of starting over, which is what keeps a retry
  // from reinstalling a server that is already running.
  provisionStep     String?
  // The variables the platform made for this instance, such as the password
  // of a database. They are encrypted with the secret of the deployment, so
  // they can be shown to the owner of the instance without being written in
  // the clear. The value is empty for an instance that needs no such variable.
  generatedVariables String?
  // The values the customer gave for the variables of the product, such as
  // the licence of a game. They are encrypted with the same secret, because
  // they are secrets of the customer and not of the platform.
  customerVariables  String?
  // Set while a worker holds the instance, so two jobs cannot provision it.
  provisionLockAt   DateTime?
  suspendedAt       DateTime?
  cancelledAt       DateTime?
  // The state of the container, as the node reports it. The customer zone
  // shows this state and not the state the platform believes, so a service
  // whose container runs is not shown as restarting for ever.
  runtimeState String?
  // What the platform concludes from what the node says: the container
  // serves, it is still coming up, or it does not serve. This is the state
  // the customer zone shows.
  runtimeCondition String?
  // When the node answered about this instance for the last time.
  runtimeStateCheckedAt DateTime?
  // True when the node could not be asked: the last known state is kept and
  // this says that it is not fresh any more. An instance whose node is not
  // reachable is never broken by that: it is only not known.
  runtimeStateStale Boolean @default(false)
  // The condition that was seen last but is not shown yet, and the moment it
  // was seen for the first time. A condition has to be seen for a while
  // before it replaces the one that is shown, so a container that flaps does
  // not make the customer zone blink between two labels.
  runtimeConditionCandidate String?
  runtimeConditionCandidateSince DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  domains         InstanceDomain[]
  ticket          Ticket[]
  events          InstanceEvent[]
  subscription    Subscription?
  provisioningJobs ProvisioningJob[]
  upgradeOrders   Order[]          @relation("UpgradeOrders")

  @@index([userId, status])
  @@index([orderItemId])
  // The list of the services is ordered by the moment of the service and by
  // the id.
  @@index([createdAt, id])
}

model InstanceEvent {
  id         String   @id @default(cuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  type       String
  message    String
  createdAt  DateTime @default(now())

  @@index([instanceId, createdAt])
}

enum DomainStatus {
  PENDING_DNS
  VERIFYING
  ACTIVE
  ERROR
}

model InstanceDomain {
  id          String       @id @default(cuid())
  instanceId  String
  instance    Instance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  hostname    String       @unique
  targetPort  Int          @default(30000)
  status      DomainStatus @default(PENDING_DNS)
  // Random per-domain proof of ownership. The customer has to publish it as a
  // TXT record before the domain can be routed.
  verificationToken String?
  verificationHost  String?
  verifiedAt        DateTime?
  // Who claimed the hostname. A hostname can only be claimed once.
  claimedByUserId   String?
  caddyRouteId String?
  lastError   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([instanceId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Support
// ---------------------------------------------------------------------------

enum TicketStatus {
  OPEN
  AWAITING_CUSTOMER
  AWAITING_STAFF
  ON_HOLD
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketCategory {
  TECHNICAL
  BILLING
  ACCOUNT
  ABUSE
  OTHER
}

model Ticket {
  id           String         @id @default(cuid())
  number       Int            @unique @default(autoincrement())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      String
  category     TicketCategory @default(TECHNICAL)
  priority     TicketPriority @default(NORMAL)
  status       TicketStatus   @default(OPEN)
  instanceId   String?
  instance     Instance?      @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   StaffMember?   @relation("TicketAssignee", fields: [assignedToId], references: [userId], onDelete: SetNull)
  lastReplyAt  DateTime?
  closedAt     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  messages TicketMessage[]
  events   TicketEvent[]
  attachments Attachment[]

  @@index([userId, status])
  @@index([assignedToId])
  // The list of the tickets is ordered by the moment of the last reply and by
  // the id.
  @@index([updatedAt, id])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  // Internal notes are never visible to the customer.
  internal   Boolean  @default(false)
  // Metadata written by clients that only describe a file. Real uploads are
  // stored as Attachment rows and referenced from here.
  attachmentMeta Json?
  attachments Attachment[]
  createdAt  DateTime @default(now())

  @@index([ticketId, createdAt])
}

model TicketEvent {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type      String
  message   String
  actorId   String?
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

// ---------------------------------------------------------------------------
// Platform operations
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
  // The journal is ordered by the moment of the entry and by the id. The
  // index that only carries the moment cannot separate two entries of the
  // same moment, so the page after the first one had to sort them.
  @@index([createdAt, id])
}

/// Idempotency ledger for provider webhooks.
///
/// status moves received -> processing -> processed, or -> failed. A failed
/// event keeps its row so a redelivery is retried instead of being discarded
/// as a duplicate.
model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  eventId    String
  type       String
  payload    Json?
  status     String   @default("received")
  attempts   Int      @default(0)
  lastAttemptAt DateTime?
  processedAt DateTime?
  error      String?
  createdAt  DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider, type])
  @@index([status])
}

/// Key/value platform settings managed by staff.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Queue of provisioning jobs, used for reconciliation and admin retry.
model ProvisioningJob {
  id          String   @id @default(cuid())
  instanceId  String
  instance    Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  step        String
  status      String   @default("pending")
  attempts    Int      @default(0)
  error       String?
  payload     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([instanceId])
  @@index([status])
}

/// The state of a job that was given up on.
enum DeadLetterState {
  /// The job failed and nobody has touched it yet.
  pending
  /// The job was put back on its queue.
  requeued
  /// The job was looked at and the failure was closed by hand.
  resolved
}

/// A job of a queue that failed for good.
///
/// The queue itself forgets a failed job after a while, so the failure is
/// written here as well: the row survives the end of the job in the queue and
/// survives a restart of the queue, and it is what an operator reads to know
/// what is broken and to put the job back on the queue.
model DeadLetterJob {
  id        String   @id @default(cuid())
  /// The name of the queue the job was on.
  queue     String
  /// The name the job had on that queue.
  jobId     String
  /// The name of the job, which says what it was doing.
  name      String
  /// What the job was carrying. It never carries a token: the payload of a
  /// job is only the identifiers of the rows it works on.
  payload   Json?
  /// The message of the failure.
  error     String
  /// The class of the failure, so the kind of problem can be told apart.
  errorClass String?
  /// How many times the job was tried before it was given up on.
  attempts  Int      @default(0)
  /// When the job was given up on.
  failedAt  DateTime @default(now())
  /// Where the failure stands.
  state     DeadLetterState @default(pending)
  /// When the job was put back on the queue, and by whom.
  requeuedAt DateTime?
  requeuedBy String?
  /// How many times the job was put back on the queue.
  requeueCount Int        @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([queue, jobId])
  @@index([state, failedAt])
}

/// A file uploaded to a support ticket. The bytes live in the attachment
/// store; the row only holds the metadata and the access rules.
model Attachment {
  id              String        @id @default(cuid())
  ticketMessageId String
  ticketMessage   TicketMessage @relation(fields: [ticketMessageId], references: [id], onDelete: Cascade)
  ticketId        String
  ticket          Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  filename        String
  contentType     String
  size            Int
  /// Path inside the attachment store. Never a public path.
  storageKey      String
  sha256          String
  createdAt       DateTime      @default(now())

  @@index([ticketMessageId])
  @@index([ticketId])
}


/// The state of a hosted domain of mail.
enum MailDomainStatus {
  /// The domain was asked for, but the mail system has not confirmed it yet.
  PENDING
  /// The mail system holds the domain and it works.
  ACTIVE
  /// The mail system refused the domain or something went wrong with it.
  ERROR
  /// The customer or the operator suspended the domain.
  SUSPENDED
}

/// Whether the customer proved that a domain of mail is theirs.
enum MailOwnershipStatus {
  /// Nobody proved anything yet. The domain is not provisioned.
  UNVERIFIED
  /// The customer proved that the domain is theirs. The domain is provisioned.
  VERIFIED
  /// The proof was tried and it did not match. The domain is not provisioned.
  FAILED
}

/// The state of a mail service, the thing a customer buys.
///
/// The mail service has its own life, apart from the server it may have been
/// bought with: cancelling the server does not cancel the mail, and cancelling
/// the mail does not cancel the server.
enum MailServiceStatus {
  /// The service was paid for and waits for its domains to be proved.
  PENDING
  /// The mail system is being asked to host the domains.
  PROVISIONING
  /// The service works.
  ACTIVE
  /// The period of grace: the service is not suspended yet, but it will be.
  GRACE
  /// The service is suspended: the mail is stopped, the data is kept.
  SUSPENDED
  /// The service was cancelled. The data is kept until the retention ends.
  CANCELLED
}

/// A domain of mail that a customer hosts.
///
/// The domain is owned by the customer, who proved that it is theirs the same
/// way they proved a hostname of a server. The mail system holds the domain,
/// the mailboxes and the aliases; the platform holds the plan limits and the
/// truth about what the mail system answered.
model MailDomain {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The mail service this domain belongs to. A domain that is not part of a
  // service is a domain the platform hosts for a customer without a plan.
  serviceId    String?
  service      MailService?     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  /// The domain itself, in lower case, e.g. "acme.ro".
  name         String
  status       MailDomainStatus @default(PENDING)
  /// Whether the customer proved that the domain is theirs.
  ownershipStatus MailOwnershipStatus @default(UNVERIFIED)
  /// The token the customer has to publish to prove the domain is theirs.
  verificationToken String?
  /// The name of the record that carries the token, e.g. "_blipmade-verify.acme.ro".
  verificationHost String?
  /// When the domain was proved.
  verifiedAt   DateTime?
  /// How much of the quota of the domain is used, in megabytes.
  quotaMb      Int              @default(10240)
  usedMb       Int              @default(0)
  /// How many mailboxes the plan allows on this domain.
  maxMailboxes Int              @default(10)
  /// How many aliases the plan allows on this domain.
  maxAliases   Int              @default(100)
  /// How many forwarding rules the plan allows on this domain.
  maxForwarding Int             @default(0)
  /// The public part of the DKIM key of the domain.
  dkimPublic   String?
  /// Why the last attempt failed, in words.
  lastError    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  mailboxes Mailbox[]
  aliases   MailAlias[]
  jobs      MailJob[]

  @@unique([userId, name])
  @@index([name])
  @@index([serviceId])
  @@index([ownershipStatus])
}

/// A mail service: what a customer buys when they buy hosted mail.
///
/// The service is the identity of the mail and it carries the limits of the
/// plan that was bought. It has no server and no instance: a customer can
/// buy mail alone, and cancelling the server they bought later does not
/// touch it.
model MailService {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The plan the customer bought.
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  // The order line that paid for it. One line, one service.
  orderItemId String? @unique
  orderItem  OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  // The order the service comes from.
  orderId    String?
  // The subscription that renews it. It has no instance: the mail is
  // renewed on its own.
  subscriptionId String? @unique
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  status     MailServiceStatus @default(PENDING)
  /// The key that makes the creation of the service safe to repeat: a
  /// redelivered payment event finds the service instead of making another.
  provisioningKey String @unique
  // The limits that were bought. They are a copy, so a change of the plan in
  // the catalog never changes a service that was already paid for.
  maxDomains      Int
  maxMailboxes    Int
  maxAliases      Int
  maxForwarding   Int
  totalStorageMb  Int
  mailboxQuotaMb  Int
  sendLimit       Int
  sendInterval    MailSendingInterval @default(HOURLY)
  // The use of the service, counted when it is asked for.
  domainCount     Int @default(0)
  mailboxCount    Int @default(0)
  // The life of the service.
  /// The end of the period of grace: after it, the service is suspended.
  graceUntil      DateTime?
  /// When the service was suspended.
  suspendedAt     DateTime?
  /// When the service was cancelled.
  cancelledAt     DateTime?
  /// The end of the retention: after it, the data of the customer is deleted.
  retentionUntil  DateTime?
  /// Why the last attempt failed, in words.
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  domains MailDomain[]

  @@index([userId, status])
  @@index([status])
}

/// A mailbox of a hosted domain.
model Mailbox {
  id         String     @id @default(cuid())
  domainId   String
  domain     MailDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  /// The part before the "@", in lower case.
  localPart  String
  /// The whole address, e.g. "contact@acme.ro".
  address    String     @unique
  /// "active" or "disabled".
  status     String     @default("active")
  quotaMb    Int        @default(1024)
  usedMb     Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([domainId, localPart])
}

/// An alias that forwards to a mailbox.
model MailAlias {
  id        String     @id @default(cuid())
  domainId  String
  domain    MailDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  /// The alias itself, e.g. "info@acme.ro".
  alias     String
  /// The mailbox the alias delivers to, e.g. "contact@acme.ro".
  target    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([domainId, alias])
}

/// A piece of work that the platform owes to the mail system.
///
/// The mail system is another system: it can refuse, it can be slow, it can
/// be down. The work is written down before it is done, so a customer always
/// sees what is pending, and a failed job is never lost.
model MailJob {
  id         String      @id @default(cuid())
  /// What the job does: "domain.create", "domain.delete", "mailbox.create",
  /// "mailbox.delete", "alias.create", "alias.delete".
  kind       String
  domainId   String?
  domain     MailDomain? @relation(fields: [domainId], references: [id], onDelete: Cascade)
  /// What the job carries.
  payload    Json
  /// "queued", "running", "done" or "failed".
  status     String      @default("queued")
  attempts   Int         @default(0)
  lastError  String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([status])
  @@index([domainId])
}
