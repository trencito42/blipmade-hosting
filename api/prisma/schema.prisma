// Blipmade platform schema.
// Money is always stored as integer minor units (EUR cents). Never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  // The name of the customer in two parts. The panel account of this customer
  // carries the same two parts, so no name is ever invented.
  firstName      String
  lastName       String
  role           Role      @default(CUSTOMER)
  emailVerifiedAt DateTime?
  // The panel account that belongs to this customer. The mapping is
  // permanent and is never derived from an address.
  pterodactylUserId String?
  // The external id that the panel account carries. It is the only link
  // between the two identities, and it is what a reconciliation looks up.
  pterodactylExternalId String? @unique
  suspendedAt    DateTime?
  // The moment the customer asked for the account to be closed. The account is
  // not deleted by the request: a person looks at it first.
  deletionRequestedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions       Session[]
  tokens         VerificationToken[]
  staff          StaffMember?
  orders         Order[]
  instances      Instance[]
  tickets        Ticket[]
  ticketMessages TicketMessage[]
  auditLogs      AuditLog[]
  invoices       Invoice[]
  payments       Payment[]
  subscriptions  Subscription[]
  promotions     Promotion[] @relation("PromotionCreator")
  promotionRedemptions PromotionRedemption[]
  panelCredential PanelCredential?
  emailChangeRequests EmailChangeRequest[]
  notificationPreference NotificationPreference?

  @@index([role])
  @@index([pterodactylUserId])
  // The list of the customers is ordered by the moment of the account and by
  // the id, so the page after the first one is read without sorting the whole
  // table.
  @@index([createdAt, id])
}

/// What is known about one message of the platform.
///
/// The row holds the state of the delivery, never the body of the message and
/// never a token: it says that a message was queued, delivered or written to
/// disk, and how many attempts it took.
model MailDelivery {
  /// The key of the message. It is a hash of the token, so it cannot be used
  /// to sign in and it is the same in every process.
  key             String   @id
  kind            String
  to              String
  /// queued, delivered, written-to-file or failed.
  state           String
  transport       String   @default("file")
  attempts        Int      @default(0)
  lastErrorClass  String?
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deliveredAt     DateTime?

  @@index([state])
  @@index([createdAt])
}

/// A change of the address of a customer.
///
/// The new address is only used when it has answered. Until then the address
/// of the account stays the old one, so a mistyped address cannot lock a
/// customer out of the account.
model EmailChangeRequest {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  // The hash of the token that was sent to the new address. The token itself
  // is never stored and never written in a log.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// What a customer wants to hear about.
///
/// The preferences are kept with the account. They say what the customer
/// wants, not what has been sent: the delivery itself depends on the mail
/// relay of the deployment.
model NotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productUpdates Boolean  @default(true)
  billing        Boolean  @default(true)
  support        Boolean  @default(true)
  incidents      Boolean  @default(true)
  marketing      Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

/// The client credential of one customer on the panel.
///
/// The panel issues one client API key per customer. The key is scoped to the
/// panel account of that customer, so it can only reach the servers of that
/// customer, and it is stored encrypted on this server. It never reaches the
/// browser.
model PanelCredential {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The panel account the key belongs to.
  panelUserId Int
  // The external id of that account on the panel.
  externalId  String
  // The client key, encrypted with the session secret of this deployment.
  tokenEnc    String
  // Where the key came from: "bridge" when the panel issued it on request,
  // "bootstrap" when an operator handed it over.
  source      String   @default("bridge")
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip        String?
  userAgent String?
  // The moment the session was last used. It is written at most once every
  // five minutes, so the list of the sessions can tell two sessions of the
  // same device apart without a write on every request.
  lastSeenAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, createdAt])
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model VerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  type      TokenType
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

model StaffMember {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String[] @default([])
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignedTickets Ticket[] @relation("TicketAssignee")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

enum Category {
  WEB_CMS
  DEVELOPER_TOOLS
  MONITORING
  AUTOMATION
  BOTS
  DATABASES
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    Category
  description String
  icon        String
  // Pterodactyl egg mapping.
  eggId       Int?
  eggUuid     String?
  dockerImage String?
  startup     Json?
  // The command the container runs. Overrides the egg default when set.
  startupCommand String?
  // Minimum resources required to run.
  minRam      Int      @default(512)
  minCpu      Int      @default(1)
  minDisk     Int      @default(5)
  // Default resources used when deploying.
  defaultRam  Int      @default(512)
  defaultCpu  Int      @default(1)
  defaultDisk Int      @default(5)
  maxRam      Int      @default(16384)
  maxCpu      Int      @default(4)
  maxDisk     Int      @default(100)
  visible     Boolean  @default(true)
  // Only genuinely validated products may be ordered.
  deployable  Boolean  @default(false)
  // How the deployment of this product is verified: { kind: 'http' | 'tcp',
  // path, expectStatus, expectBody }.
  healthProbe Json?
  docsUrl     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prices   ProductPrice[]
  options  ProductOption[]
  items    OrderItem[]
  instances Instance[]

  @@index([visible, deployable])
  @@index([category])
}

model ProductPrice {
  id           String        @id @default(cuid())
  productId    String
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  period       BillingPeriod @default(MONTHLY)
  // Amount for the minimum configuration, in minor units.
  baseAmount   Int
  // Price per additional GB of RAM, in minor units.
  ramPerGb     Int           @default(60)
  cpuPerUnit   Int           @default(40)
  diskPerGb    Int           @default(2)
  currency     String        @default("EUR")
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([productId, period, active])
}

/// Paid add-on features that can be attached to an order.
model ProductOption {
  id        String   @id @default(cuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  code      String   @unique
  name      String
  description String?
  amount    Int
  currency  String   @default("EUR")
  recurring Boolean  @default(true)
  active    Boolean  @default(true)

  @@index([productId])
}

/// Cached copy of a Pterodactyl node.
model Node {
  id              String   @id @default(cuid())
  pterodactylId   Int      @unique
  name            String
  fqdn            String
  memory          Int
  disk            Int
  memoryAllocated Int      @default(0)
  diskAllocated   Int      @default(0)
  maintenance     Boolean  @default(false)
  syncedAt        DateTime @default(now())
}

/// Cached copy of a Pterodactyl egg.
model Egg {
  id            String   @id @default(cuid())
  pterodactylId Int      @unique
  uuid          String
  name          String
  dockerImage   String
  startup       String
  syncedAt      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Customers, orders and billing
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  FULFILLED
  FAILED
  CANCELLED
  REFUNDED
}

/// A new purchase, or a paid change applied to an existing instance.
enum OrderKind {
  NEW
  UPGRADE
}

/// Tracks whether the paid order actually produced running services.
/// It is deliberately separate from Order.status, which only describes money.
enum FulfillmentStatus {
  NOT_STARTED
  PROVISIONING
  FULFILLED
  FAILED
}

model Order {
  id         String      @id @default(cuid())
  number     String      @unique
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     OrderStatus @default(PENDING)
  /// NEW orders create instances, UPGRADE orders change the resources of one.
  kind       OrderKind   @default(NEW)
  /// Set on UPGRADE orders: the instance whose resources are being changed.
  instanceId String?
  instance   Instance?   @relation("UpgradeOrders", fields: [instanceId], references: [id], onDelete: SetNull)
  /// The requested resources of an UPGRADE order, frozen like an order item.
  requestedConfig Json?
  /// Money state and fulfilment state are tracked separately.
  fulfillmentStatus FulfillmentStatus @default(NOT_STARTED)
  total      Int
  currency   String      @default("EUR")
  promotionId String?
  promotion  Promotion?  @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  discount   Int         @default(0)
  /// Set when the promotion was actually consumed by a paid order.
  promotionRedeemedAt DateTime?
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String?
  paidAt     DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  items    OrderItem[]
  payments Payment[]
  invoices Invoice[]
  instances Instance[]
  promotionRedemption PromotionRedemption?

  @@index([userId, status])
  @@index([status])
  @@index([kind])
  @@index([instanceId])
  // The list of the orders is ordered by the moment of the order and by the
  // id.
  @@index([createdAt, id])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  name       String
  quantity   Int      @default(1)
  unitAmount Int
  total      Int
  currency   String   @default("EUR")
  // Frozen resource configuration, so prices never change retroactively.
  config     Json?

  // Every order line owns at most one subscription, so a multi-item checkout
  // produces one subscription per item instead of one for the whole order.
  subscription Subscription?
  instances    Instance[]

  @@index([orderId])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  instanceId           String?            @unique
  instance             Instance?          @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  // The order line this subscription pays for.
  orderItemId          String?            @unique
  orderItem            OrderItem?         @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  // The Stripe subscription can cover several order lines, so the id is not
  // unique here. The Stripe subscription *item* is what identifies one line.
  stripeSubscriptionId String?
  stripeSubscriptionItemId String? @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(INCOMPLETE)
  quantity             Int                @default(1)
  amount               Int
  currency             String             @default("EUR")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  cancelledAt          DateTime?
  /// Last time the renewal sweep looked at this subscription.
  lastRenewalCheckAt   DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId])
  @@index([status])
  @@index([cancelAtPeriodEnd])
  @@index([stripeSubscriptionId])
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId        String?
  order          Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  stripeInvoiceId String?      @unique
  stripeSubscriptionId String?
  stripeCustomerId String?
  status         InvoiceStatus @default(DRAFT)
  amount         Int
  tax            Int           @default(0)
  total          Int
  currency       String        @default("EUR")
  hostedUrl      String?
  pdfUrl         String?
  paidAt         DateTime?
  periodStart    DateTime?
  periodEnd      DateTime?
  dueDate        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  // The list of the invoices is ordered by the moment of the invoice and by
  // the id.
  @@index([createdAt, id])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                     String        @id @default(cuid())
  userId                 String
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId                String?
  order                  Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  stripePaymentIntentId  String?       @unique
  stripeChargeId         String?
  // The Stripe customer is what the billing portal needs, so it is stored as
  // soon as a checkout session exposes it.
  stripeCustomerId       String?       @unique
  stripeSubscriptionId   String?
  stripeInvoiceId        String?       @unique
  amount                 Int
  currency               String        @default("EUR")
  status                 PaymentStatus @default(PENDING)
  failureMessage         String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

enum PromotionType {
  PERCENT
  FIXED
}

model Promotion {
  id             String        @id @default(cuid())
  code           String        @unique
  type           PromotionType
  value          Int
  maxRedemptions Int?
  /// How many times a single account may use the code.
  maxPerUser     Int?
  usedCount      Int           @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean       @default(true)
  createdById    String?
  createdBy      User?         @relation("PromotionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  orders Order[]
  /// One row per paid order that used the promotion. Redemptions are counted
  /// from this table, never from an unpaid order.
  redemptions PromotionRedemption[]

  @@index([active])
}

/// A promotion that was actually used by a paid order.
/// The unique constraint makes the redemption idempotent: a redelivered
/// webhook cannot consume the promotion twice.
model PromotionRedemption {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// The discounted amount, in minor units.
  amount      Int
  createdAt   DateTime  @default(now())

  @@index([promotionId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Instances
// ---------------------------------------------------------------------------

enum InstanceStatus {
  PENDING
  PROVISIONING
  ONLINE
  RESTARTING
  STOPPED
  DEGRADED
  FAILED
  SUSPENDED
  CANCELLED
}

model Instance {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId         String
  product           Product        @relation(fields: [productId], references: [id])
  orderId           String?
  order             Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // The order line this instance was provisioned from. A line with a quantity
  // above one produces several instances that all point at the same line.
  orderItemId       String?
  orderItem         OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  name              String
  status            InstanceStatus @default(PENDING)
  pterodactylServerId Int?          @unique
  pterodactylUuid   String?        @unique
  // The allocation that the panel really assigned. The port of the service
  // is read from it and is never assumed.
  pterodactylAllocation Int?
  pterodactylNodeId     Int?
  ram               Int
  cpu               Int
  disk              Int
  price             Int
  currency          String         @default("EUR")
  // Idempotency key used by the provisioning worker.
  provisioningKey   String?        @unique
  provisionError    String?
  // The last provisioning step that completed successfully. A retry resumes
  // after this step instead of starting over, which is what keeps a retry
  // from reinstalling a server that is already running.
  provisionStep     String?
  // Set while a worker holds the instance, so two jobs cannot provision it.
  provisionLockAt   DateTime?
  suspendedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  domains         InstanceDomain[]
  ticket          Ticket[]
  events          InstanceEvent[]
  subscription    Subscription?
  provisioningJobs ProvisioningJob[]
  upgradeOrders   Order[]          @relation("UpgradeOrders")

  @@index([userId, status])
  @@index([orderItemId])
  // The list of the services is ordered by the moment of the service and by
  // the id.
  @@index([createdAt, id])
}

model InstanceEvent {
  id         String   @id @default(cuid())
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  type       String
  message    String
  createdAt  DateTime @default(now())

  @@index([instanceId, createdAt])
}

enum DomainStatus {
  PENDING_DNS
  VERIFYING
  ACTIVE
  ERROR
}

model InstanceDomain {
  id          String       @id @default(cuid())
  instanceId  String
  instance    Instance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  hostname    String       @unique
  targetPort  Int          @default(30000)
  status      DomainStatus @default(PENDING_DNS)
  // Random per-domain proof of ownership. The customer has to publish it as a
  // TXT record before the domain can be routed.
  verificationToken String?
  verificationHost  String?
  verifiedAt        DateTime?
  // Who claimed the hostname. A hostname can only be claimed once.
  claimedByUserId   String?
  caddyRouteId String?
  lastError   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([instanceId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Support
// ---------------------------------------------------------------------------

enum TicketStatus {
  OPEN
  AWAITING_CUSTOMER
  AWAITING_STAFF
  ON_HOLD
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketCategory {
  TECHNICAL
  BILLING
  ACCOUNT
  ABUSE
  OTHER
}

model Ticket {
  id           String         @id @default(cuid())
  number       Int            @unique @default(autoincrement())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      String
  category     TicketCategory @default(TECHNICAL)
  priority     TicketPriority @default(NORMAL)
  status       TicketStatus   @default(OPEN)
  instanceId   String?
  instance     Instance?      @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   StaffMember?   @relation("TicketAssignee", fields: [assignedToId], references: [userId], onDelete: SetNull)
  lastReplyAt  DateTime?
  closedAt     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  messages TicketMessage[]
  events   TicketEvent[]
  attachments Attachment[]

  @@index([userId, status])
  @@index([assignedToId])
  // The list of the tickets is ordered by the moment of the last reply and by
  // the id.
  @@index([updatedAt, id])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  // Internal notes are never visible to the customer.
  internal   Boolean  @default(false)
  // Metadata written by clients that only describe a file. Real uploads are
  // stored as Attachment rows and referenced from here.
  attachmentMeta Json?
  attachments Attachment[]
  createdAt  DateTime @default(now())

  @@index([ticketId, createdAt])
}

model TicketEvent {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type      String
  message   String
  actorId   String?
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

// ---------------------------------------------------------------------------
// Platform operations
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
  // The journal is ordered by the moment of the entry and by the id. The
  // index that only carries the moment cannot separate two entries of the
  // same moment, so the page after the first one had to sort them.
  @@index([createdAt, id])
}

/// Idempotency ledger for provider webhooks.
///
/// status moves received -> processing -> processed, or -> failed. A failed
/// event keeps its row so a redelivery is retried instead of being discarded
/// as a duplicate.
model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  eventId    String
  type       String
  payload    Json?
  status     String   @default("received")
  attempts   Int      @default(0)
  lastAttemptAt DateTime?
  processedAt DateTime?
  error      String?
  createdAt  DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider, type])
  @@index([status])
}

/// Key/value platform settings managed by staff.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Queue of provisioning jobs, used for reconciliation and admin retry.
model ProvisioningJob {
  id          String   @id @default(cuid())
  instanceId  String
  instance    Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  step        String
  status      String   @default("pending")
  attempts    Int      @default(0)
  error       String?
  payload     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([instanceId])
  @@index([status])
}

/// The state of a job that was given up on.
enum DeadLetterState {
  /// The job failed and nobody has touched it yet.
  pending
  /// The job was put back on its queue.
  requeued
  /// The job was looked at and the failure was closed by hand.
  resolved
}

/// A job of a queue that failed for good.
///
/// The queue itself forgets a failed job after a while, so the failure is
/// written here as well: the row survives the end of the job in the queue and
/// survives a restart of the queue, and it is what an operator reads to know
/// what is broken and to put the job back on the queue.
model DeadLetterJob {
  id        String   @id @default(cuid())
  /// The name of the queue the job was on.
  queue     String
  /// The name the job had on that queue.
  jobId     String
  /// The name of the job, which says what it was doing.
  name      String
  /// What the job was carrying. It never carries a token: the payload of a
  /// job is only the identifiers of the rows it works on.
  payload   Json?
  /// The message of the failure.
  error     String
  /// The class of the failure, so the kind of problem can be told apart.
  errorClass String?
  /// How many times the job was tried before it was given up on.
  attempts  Int      @default(0)
  /// When the job was given up on.
  failedAt  DateTime @default(now())
  /// Where the failure stands.
  state     DeadLetterState @default(pending)
  /// When the job was put back on the queue, and by whom.
  requeuedAt DateTime?
  requeuedBy String?
  /// How many times the job was put back on the queue.
  requeueCount Int        @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([queue, jobId])
  @@index([state, failedAt])
}

/// A file uploaded to a support ticket. The bytes live in the attachment
/// store; the row only holds the metadata and the access rules.
model Attachment {
  id              String        @id @default(cuid())
  ticketMessageId String
  ticketMessage   TicketMessage @relation(fields: [ticketMessageId], references: [id], onDelete: Cascade)
  ticketId        String
  ticket          Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  filename        String
  contentType     String
  size            Int
  /// Path inside the attachment store. Never a public path.
  storageKey      String
  sha256          String
  createdAt       DateTime      @default(now())

  @@index([ticketMessageId])
  @@index([ticketId])
}
