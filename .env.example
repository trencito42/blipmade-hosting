# Blipmade — the hosted mail.
#
# The platform hosts the mail of the customers with a mail server of its own
# (Mailcow). This file says what the operator has to write down and where.
#
# Every value here is a throwaway or a shape. Nothing in this file is a real
# secret and nothing in this file is a real key. The real file is `.env` on the
# platform host, and it is never in the repository.
#
# The full guide is in `docs/MAIL_HOSTING.md`.

# ---------------------------------------------------------------------------
# The mail server of the platform
# ---------------------------------------------------------------------------

# The address of the administrative API of the mail server, over HTTPS.
# The format is a URL: https://<the name of the machine>
MAILCOW_API_URL=https://mail.blipmade.com

# The key of the platform at the API of the mail server.
# The format is a long string of hexadecimal characters. The key is created by
# the operator in the mail server and it never leaves the machine.
MAILCOW_API_KEY=

# The fingerprint of the certificate of the mail server, in lower case hex.
# The format is 64 hexadecimal characters, the SHA-256 of the certificate.
# It is empty when the certificate is signed by an authority the machine
# already trusts. It is not empty while the name of the machine is not
# published in the DNS.
MAILCOW_API_CERT_SHA256=

# The name of the machine of the mail server. It is the name in the
# certificate and the name that the DNS of the hosted domains points at.
MAIL_HOSTNAME=mail.blipmade.com

# Where the customer reads the mail of a customer domain.
MAIL_WEBMAIL_URL=https://mail.blipmade.com

# The mailbox that receives the reports of DMARC of the hosted domains.
# The format is a bare address, without a display name.
MAIL_RUA_ADDRESS=postmaster@blipmade.com

# ---------------------------------------------------------------------------
# The limits of the plan
# ---------------------------------------------------------------------------
#
# They are read by the API when it starts, and they are the limits that the
# customer sees in the interface. They are the limits that the mail server is
# asked to enforce as well, so the two sides agree.

# How many domains of mail one customer may host.
MAIL_MAX_DOMAINS_PER_CUSTOMER=3

# How many mailboxes one domain of mail may hold.
MAIL_MAX_MAILBOXES_PER_DOMAIN=10

# How many aliases one domain of mail may hold.
MAIL_MAX_ALIASES_PER_DOMAIN=100

# How much mail one mailbox may hold, in megabytes.
MAIL_MAX_QUOTA_MB_PER_MAILBOX=1024

# How much mail one domain of mail may hold, in megabytes.
MAIL_MAX_QUOTA_MB_PER_DOMAIN=10240

# How many forwarding rules one domain of mail may hold.
MAIL_MAX_FORWARDING_PER_DOMAIN=10

# The most messages a domain may send in the window of its plan, whatever the
# plan says. The limit of the plan is the limit of the customer and this one
# is the ceiling of the platform: the smaller of the two is the one that is
# written in the mail server.
MAIL_MAX_SEND_LIMIT=500

# ---------------------------------------------------------------------------
# The sale of hosted mail
# ---------------------------------------------------------------------------
#
# The sale of the mail is closed by default. It is opened when the payment,
# the mail server, the DNS, the backup and the delivery have been proved from
# end to end, and not before. While it is closed, the plans of mail can be
# read but not bought, and the interface says so.

# Whether the plans of hosted mail can be bought. "true" or "false".
MAIL_SALES_ENABLED=false

# How many days a mail service keeps working after it stops being paid for.
# The period of grace is the time the customer has to pay: the mail is not
# suspended before it ends.
MAIL_GRACE_PERIOD_DAYS=14

# How many days the data of a mail service is kept after it was suspended.
# The data of a customer is never deleted the moment a payment fails.
MAIL_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# The relay of the transactional mail
# ---------------------------------------------------------------------------
#
# The relay of the platform sends the messages that the platform owes to its
# customers: the verification of the account, the reset of the password and
# the notices of the back office.

# The address of the relay. The format is a URL and the name of the mailbox is
# the whole address, because the relay refuses to send in the name of another
# mailbox:
#   smtp://no-reply%40blipmade.com:<the password>@<the name of the machine>:587
# An empty value means that the messages are written on the disk instead of
# being delivered, and nobody receives them.
SMTP_URL=

# The certificate of the relay, when the relay is not signed by an authority
# the machine trusts. The format is the path of a file that holds the
# certificate in the format of PEM. An empty value is the right value for a
# relay of a provider.
SMTP_CA_FILE=

# How long the platform waits for the relay, in milliseconds. A relay that
# does not answer in that time is a relay that is not there, and the message
# is failed so it can be tried again.
SMTP_TIMEOUT_MS=15000

# How many messages the platform hands to the relay in one minute. The limit
# keeps the platform from looking like a spammer and from overloading the
# relay when a whole campaign goes out at once.
SMTP_RATE_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------------------
# The addresses of the platform
# ---------------------------------------------------------------------------
#
# Every message of the platform is sent by the same mailbox, and the answers
# go to the inbox the operator chooses. These addresses are never the ones of
# the mail system, so the alert of a broken mail system still arrives.

# The sender of every message. The name in front of the address is the label
# the customer reads.
MAIL_FROM="Blipmade <no-reply@blipmade.com>"
MAIL_SENDER_NAME=Blipmade

# Where the answers go. An empty value means the answers go back to the
# sender, which is the safe choice when the operator has not chosen one.
MAIL_REPLY_TO=

# The inbox that receives the messages about the support of the customers.
MAIL_SUPPORT_EMAIL=support@blipmade.com

# The inbox that receives the alarms about the operation of the platform.
MAIL_OPERATOR_EMAIL=

# The inbox that receives the messages about the money of the platform, when
# the operator wants them apart from the support.
MAIL_BILLING_EMAIL=

# The address a customer may write to when a message is wrong. It is empty
# when there is none.
MAIL_HELP_EMAIL=
